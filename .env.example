# ------------------------------------------------------------------
# Easy Scripts WebApp – Konfiguration
# Alle Werte sind optional; die Defaults funktionieren out-of-the-box.
# ------------------------------------------------------------------

# HTTP-Server
PORT=3001
HOST=127.0.0.1
# Hinter Proxy (NGINX): X-Forwarded-* Header vertrauen
TRUST_PROXY=true

# Kanonische öffentliche URL (überschreibt Auto-Erkennung in curl-Befehlen).
# Kann alternativ im Admin-Panel gesetzt werden (Einstellungen → Integration).
#PUBLIC_URL=https://install.example.com

# Alternative: nur die Domain angeben (Fallback, falls PUBLIC_URL leer ist
# und im Admin-Panel nichts gesetzt wurde). Ohne Schema wird http://
# vorangestellt – passend für Cloudflare-Tunnel-Setups (intern HTTP).
#INSTALLATION_DOMAIN=install-dashboard.example.com

# Datenverzeichnis (DB, Script-Cache, Sessions, Secret)
#DATA_DIR=/var/lib/easy-scripts

# Session-Secret. Wird sonst automatisch generiert und in DATA_DIR/.secret
# gespeichert. Ändern macht bestehende Sessions und gespeicherte
# GitLab-Tokens ungültig!
#SESSION_SECRET=

# Session-Lebensdauer in Stunden (Default: 168 = 7 Tage)
#SESSION_TTL_HOURS=168

# GitLab: Hosts einschränken (Komma-Liste). Leer = alle Hosts erlaubt.
#GITLAB_ALLOWED_HOSTS=gitlab.com,git.example.com

# Maximale Script-Größe in Bytes (Default: 1 MB)
#MAX_SCRIPT_BYTES=1048576

# Auto-Update-Intervall für Scripts mit "autoUpdate" in Minuten (0 = aus)
SCRIPT_REFRESH_INTERVAL=60

# NGINX-Integration
NGINX_CONF_PATH=/etc/nginx/conf.d/install-manager.conf
NGINX_RELOAD_CMD=nginx -t && (systemctl reload nginx || nginx -s reload)
# Auf false setzen, um den "Anwenden"-Button im Admin-Panel zu deaktivieren
# (Konfiguration wird dann nur als Vorschau angezeigt).
NGINX_AUTO_APPLY=true
